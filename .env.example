# No credentials are read or SDK clients created in mock mode.
LLM_MODE=mock
WRITER_PROVIDER=openai
WRITER_MODEL=
REVIEWER_PROVIDER=anthropic
REVIEWER_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Per-stage timeout, 1000–60000 ms. Each SDK makes one attempt.
LLM_TIMEOUT_MS=30000
LLM_MAX_OUTPUT_TOKENS=2048
# Simulated latency per stage, 0–2000 ms.
MOCK_DELAY_MS=700
